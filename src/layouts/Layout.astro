---
import '@/styles/global.css'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Detallito 💖</title>
		<meta name="description" content="Hice este detalle para ti 💖" />
		<meta name="author" content="Ann" />
		<meta name="keywords" content="Astro, AstroJS, Astro Framework, Astro Meta Tags" />

		<!-- og -->
		<meta property="og:title" content="Detallito 💖" />
		<meta property="og:description" content="Hice este detalle para ti 💖" />
		<meta property="og:image" content="/og-image.png" />
		<meta property="og:url" content="https://secreto-detalle-io.netlify.app/" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Detallito 💖" />
		<meta property="og:locale" content="es_ES" />

		<!-- twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Detallito 💖" />
		<meta name="twitter:description" content="Hice este detalle para ti 💖" />
		<meta name="twitter:image" content="/og-image.png" />


	</head>
	<body
		class="bg-pink-200 text-neutral-950 flex justify-center items-center px-4"
	>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<style is:global>

	.fade-up{
		animation: fade-up 0.5s ease-out;
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

</style>
